# ==============================================================================
# NIPËI OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copie este archivo a .env.production o configure estas variables en su VPS / Docker
# ==============================================================================

# Entorno y Puerto
NODE_ENV=production
PORT=3333
NEXT_PUBLIC_APP_URL=https://control.nipei.org

# Ruta al Vault Master de Nipëi (Clonado en el servidor)
# Ejemplo en Linux VPS: /var/www/nipei-vault o /home/nipei/nipei-vault
VAULT_PATH=/var/www/nipei-vault
AGENTIC_OS_VAULT=/var/www/nipei-vault

# AI Model Providers & Router
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ORCA_API_KEY=your_orca_api_key_here
AI_GATEWAY_URL=http://localhost:8090/v1

# Cloudflare Ecosystem & CDN
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Hostinger VPS Host & Deployment
VPS_IP=85.31.61.100
VPS_USER=root
VPS_SSH_KEY_PATH=/root/.ssh/id_rsa

# Evolution API (WhatsApp Engine)
EVOLUTION_API_URL=https://evolution.digital-alignment.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=nipei-santuario

# n8n Automation Engine
N8N_URL=https://panter.digital-alignment.com/
